# ==========================================================================
# PharmaCentral — Environment Variables
# ==========================================================================
# Local dev:  copy this file to `.env` and fill in the values you need.
# Vercel:     add these same keys under  Project -> Settings -> Environment
#             Variables  (do NOT commit real secrets to git).
# ==========================================================================

# --- Gemini AI (optional) -------------------------------------------------
# Powers the AI Assistant (prescription parsing, interaction checks, reorder
# forecasting, executive summary). If left unset, every AI feature still works
# using built-in deterministic fallback responses — no crash.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Supabase persistence (optional but recommended for production) -------
# If BOTH of these are set, all data is stored durably in Supabase (Postgres)
# and survives restarts / serverless cold starts. If they are NOT set, the app
# falls back to an in-memory store (data resets on every restart) — fine for
# local development, but NOT suitable for real Vercel deployments.
#
# Find these in Supabase:  Project Settings -> API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret (server-side only!)
SUPABASE_URL="https://yelpaiwwuqjutnmoqcli.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (optional) ---------------------------------------------------
# The public URL where this app is hosted. Used for self-referential links.
# On Vercel this is provided automatically; you usually don't need to set it.
APP_URL="MY_APP_URL"
